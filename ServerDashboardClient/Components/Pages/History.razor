@page "/history"
@rendermode InteractiveServer

<div class="dash-page">
    <header class="dash-header">
        <div>
            <div class="dash-eyebrow">Temperature monitoring</div>
            <h1 class="dash-title">Temperature History</h1>
            <p class="dash-subtitle">
                Track temperature trends and review historical readings over time.
            </p>
        </div>
        @if (data != null && data.Any()){
            <span class="dash-chip">
                @data.Count() @(data.Count() > 1 ? " Items" : " Item")
            </span>
        }
    </header>

  
    @if (data == null)
    {
        <div class="dash-card dash-loading">
            <div class="spinner-border" style="color: var(--dash-primary);" role="status"></div>
            <p class="text-muted mb-0">Loading temperatures…</p>
        </div>
    }
    else if(!data.Any())
    {
        <div class="dash-card dash-empty">
            <span class="dash-card__icon dash-card__icon--indigo mx-auto mb-3" style="width:3.5rem;height:3.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" style="width:1.5rem;height:1.5rem;">
                    <path d="M4.5 5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1M3 4.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0" />
                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H8.5v3a1.5 1.5 0 0 1 1.5 1.5h5.5a.5.5 0 0 1 0 1H10A1.5 1.5 0 0 1 8.5 14h-1A1.5 1.5 0 0 1 6 12.5H.5a.5.5 0 0 1 0-1H6A1.5 1.5 0 0 1 7.5 10V7H2a2 2 0 0 1-2-2zm1 0v1a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1zm6 7.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5" />
                </svg>
            </span>
            <h4 class="fw-bold">No history found</h4>
            <p class="text-muted mb-0">There are currently no temperatures registered.</p>
        </div>
    }
    else
    {
        <div class="dash-card dash-form-card">
            <Chart Config="_config"></Chart>
        </div>
    }
</div>