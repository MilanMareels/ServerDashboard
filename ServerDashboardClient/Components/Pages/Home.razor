@page "/"
@rendermode InteractiveServer

<PageTitle>Server Dashboard</PageTitle>

<div class="dash-page">
    <header class="dash-header">
        <div>
            <div class="dash-eyebrow">
                <span class="dash-dot dash-dot--pulse"></span>
                Live monitoring
            </div>
            <h1 class="dash-title">Server Status</h1>
            <p class="dash-subtitle">Real-time overview of temperature, cooling and events</p>
        </div>
        <span class="dash-chip">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M8 3.5a.5.5 0 0 0-1 0V8a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 7.71V3.5z"/>
            </svg>
            Auto-refresh every 2 minutes
        </span>
    </header>

    @if (dashBoard != null)
    {
        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="dash-card d-flex flex-column">
                    <div class="dash-card__header">
                        <span class="dash-card__icon dash-card__icon--temp">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M9.5 12.5a1.5 1.5 0 1 1-2-1.415V2.5a.5.5 0 0 1 1 0v8.585a1.5 1.5 0 0 1 1 1.415Z"/>
                                <path d="M5.5 2.5a2.5 2.5 0 0 1 5 0v7.55a3.5 3.5 0 1 1-5 0V2.5ZM8 1a2 2 0 0 0-1 0v2h2V1Z"/>
                            </svg>
                        </span>
                        <span class="dash-card__label">Current Temperature</span>
                    </div>

                    <div class="dash-temp">
                        <span class="dash-temp__value @TempValueClass">@dashBoard.Temp</span>
                        <span class="dash-temp__unit">&deg;C</span>
                    </div>

                    <span class="dash-pill @TempPillClass align-self-start">
                        <span class="dash-dot @(IsHighTemp ? "dash-dot--off" : "")"></span>
                        @TempStatus
                    </span>

                    <div class="dash-range mt-auto">
                        <div class="dash-range__labels">
                            <span>@dashBoard.MinTemp&deg;C min</span>
                            <span>@dashBoard.MaxTemp&deg;C max</span>
                        </div>
                        <div class="dash-range__track">
                            <div class="dash-range__fill" style="width: @TempPercent%"></div>
                            <div class="dash-range__thumb" style="left: @TempPercent%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="row g-4 h-100">
                    <div class="col-6">
                        <div class="dash-card d-flex flex-column">
                            <div class="dash-card__header">
                                <span class="dash-card__icon dash-card__icon--green">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M9.5 12.5a1.5 1.5 0 1 1-2-1.415V2.5a.5.5 0 0 1 1 0v8.585a1.5 1.5 0 0 1 1 1.415Z"/>
                                        <path d="M5.5 2.5a2.5 2.5 0 0 1 5 0v7.55a3.5 3.5 0 1 1-5 0V2.5ZM8 1a2 2 0 0 0-1 0v2h2V1Z"/>
                                    </svg>
                                </span>
                                <span class="dash-card__label">Minimum</span>
                            </div>
                            <div class="dash-stat mt-auto">
                                <span class="dash-stat__value">@dashBoard.MinTemp<span class="dash-stat__unit">&deg;C</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="dash-card d-flex flex-column">
                            <div class="dash-card__header">
                                <span class="dash-card__icon dash-card__icon--temp">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M9.5 12.5a1.5 1.5 0 1 1-2-1.415V2.5a.5.5 0 0 1 1 0v8.585a1.5 1.5 0 0 1 1 1.415Z"/>
                                        <path d="M5.5 2.5a2.5 2.5 0 0 1 5 0v7.55a3.5 3.5 0 1 1-5 0V2.5ZM8 1a2 2 0 0 0-1 0v2h2V1Z"/>
                                    </svg>
                                </span>
                                <span class="dash-card__label">Maximum</span>
                            </div>
                            <div class="dash-stat mt-auto">
                                <span class="dash-stat__value">@dashBoard.MaxTemp<span class="dash-stat__unit">&deg;C</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="dash-card">
                            <div class="dash-card__header">
                                <span class="dash-card__icon dash-card__icon--sky">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M12.5 2A2.5 2.5 0 0 0 10 4.5a.5.5 0 0 1-1 0A3.5 3.5 0 1 1 12.5 8H.5a.5.5 0 0 1 0-1h12a2.5 2.5 0 0 0 0-5zm-7 1a1 1 0 0 0-1 1 .5.5 0 0 1-1 0 2 2 0 1 1 2 2h-5a.5.5 0 0 1 0-1h5a1 1 0 0 0 0-2zM0 9.5A.5.5 0 0 1 .5 9h10.042a3 3 0 1 1-3 3 .5.5 0 0 1 1 0 2 2 0 1 0 2-2H.5a.5.5 0 0 1-.5-.5z"/>
                                    </svg>
                                </span>
                                <span class="dash-card__label">Cooling Fans</span>
                            </div>

                            <div class="dash-fan-row">
                                <span class="dash-fan-row__name">
                                    <span class="dash-fan-row__icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                            <path d="M12.5 2A2.5 2.5 0 0 0 10 4.5a.5.5 0 0 1-1 0A3.5 3.5 0 1 1 12.5 8H.5a.5.5 0 0 1 0-1h12a2.5 2.5 0 0 0 0-5zm-7 1a1 1 0 0 0-1 1 .5.5 0 0 1-1 0 2 2 0 1 1 2 2h-5a.5.5 0 0 1 0-1h5a1 1 0 0 0 0-2zM0 9.5A.5.5 0 0 1 .5 9h10.042a3 3 0 1 1-3 3 .5.5 0 0 1 1 0 2 2 0 1 0 2-2H.5a.5.5 0 0 1-.5-.5z"/>
                                        </svg>
                                    </span>
                                    Top Fans
                                </span>
                                <span class="dash-state @(dashBoard.TopFans == "ON" ? "dash-state--on" : "dash-state--off")">
                                    <span class="dash-dot @(dashBoard.TopFans == "ON" ? "" : "dash-dot--off")"></span>
                                    @dashBoard.TopFans
                                </span>
                            </div>

                            <div class="dash-fan-row">
                                <span class="dash-fan-row__name">
                                    <span class="dash-fan-row__icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                            <path d="M12.5 2A2.5 2.5 0 0 0 10 4.5a.5.5 0 0 1-1 0A3.5 3.5 0 1 1 12.5 8H.5a.5.5 0 0 1 0-1h12a2.5 2.5 0 0 0 0-5zm-7 1a1 1 0 0 0-1 1 .5.5 0 0 1-1 0 2 2 0 1 1 2 2h-5a.5.5 0 0 1 0-1h5a1 1 0 0 0 0-2zM0 9.5A.5.5 0 0 1 .5 9h10.042a3 3 0 1 1-3 3 .5.5 0 0 1 1 0 2 2 0 1 0 2-2H.5a.5.5 0 0 1-.5-.5z"/>
                                        </svg>
                                    </span>
                                    Bottom Fans
                                </span>
                                <span class="dash-state @(dashBoard.BottomFans == "ON" ? "dash-state--on" : "dash-state--off")">
                                    <span class="dash-dot @(dashBoard.BottomFans == "ON" ? "" : "dash-dot--off")"></span>
                                    @dashBoard.BottomFans
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-0">
            <div class="col-12">
                <div class="dash-card">
                    <div class="dash-card__title">
                        <div class="d-flex align-items-center gap-2">
                            <span class="dash-card__icon dash-card__icon--amber" style="width:2rem;height:2rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" style="width:1rem;height:1rem;">
                                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                                </svg>
                            </span>
                            <h3 class="fw-bold mb-0" style="font-size:1.05rem;">Event Log</h3>
                        </div>
                        @if (serverEvents != null)
                        {
                            <span class="dash-chip">@serverEvents.Count() events</span>
                        }
                    </div>

                    <div class="dash-table-wrap overflow-auto" style="max-height: 420px;">
                        <table class="dash-table align-middle">
                            <thead>
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Severity</th>
                                    <th>Temperature</th>
                                    <th>Event Info</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (serverEvents != null && serverEvents.Any())
                                {
                                    @foreach (var ev in serverEvents)
                                    {
                                        <tr>
                                            <td class="text-muted fw-medium" style="white-space:nowrap;">@ev.Date.AddHours(2).ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>
                                                <span class="dash-badge @(ev.Severity == "Critical" ? "dash-badge--danger" : "dash-badge--warning")">
                                                    <span class="dash-dot @(ev.Severity == "Critical" ? "dash-dot--off" : "dash-dot--warning")" style="width:6px;height:6px;"></span>
                                                    @ev.Severity
                                                </span>
                                            </td>
                                            <td class="fw-bold text-danger">@ev.Temp&deg;C</td>
                                            <td class="text-muted">High temperature threshold exceeded.</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-5">No events found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="dash-card dash-loading">
            <div class="spinner-border" style="color: var(--dash-primary);" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mb-0">Loading dashboard…</p>
        </div>
    }
</div>
