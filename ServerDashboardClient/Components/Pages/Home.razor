@page "/"
@rendermode InteractiveServer

<PageTitle>Server Dashboard</PageTitle>

<div class="container-fluid min-vh-100 bg-light p-3 p-md-5 d-flex flex-column">

    <header class="mb-4">
        <h1 class="display-5 fw-bold text-dark text-uppercase tracking-wider">Server Status</h1>
        <p class="text-muted lead">Real-time Overview</p>
    </header>

    @if (dashBoard != null)
    {
        <div class="row g-4 flex-grow-0 mb-4">

            <div class="col-12 col-lg-6 d-flex">
                <div class="card shadow border-0 rounded-4 w-100 p-4 d-flex flex-column justify-content-center align-items-center text-center">
                    <h3 class="text-muted text-uppercase fw-bold mb-4">Current Temperature</h3>

                    <div class="fw-bolder lh-1 @(dashBoard.Temp >= 25 ? "text-danger" : "text-primary")" style="font-size: clamp(6rem, 15vw, 12rem);">
                        @dashBoard.Temp&deg;C
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6 d-flex flex-column gap-4">

                <div class="row g-4 flex-grow-1">
                    <div class="col-6 d-flex">
                        <div class="card shadow border-0 rounded-4 w-100 p-4 text-center d-flex flex-column justify-content-center">
                            <span class="text-muted text-uppercase fw-bold mb-2">Minimum</span>
                            <span class="display-5 fw-bold text-dark">@dashBoard.MinTemp&deg;C</span>
                        </div>
                    </div>

                    <div class="col-6 d-flex">
                        <div class="card shadow border-0 rounded-4 w-100 p-4 text-center d-flex flex-column justify-content-center">
                            <span class="text-muted text-uppercase fw-bold mb-2">Maximum</span>
                            <span class="display-5 fw-bold text-dark">@dashBoard.MaxTemp&deg;C</span>
                        </div>
                    </div>
                </div>

                <div class="card shadow border-0 rounded-4 w-100 p-4 flex-grow-1 d-flex flex-column justify-content-center">
                    <h4 class="text-muted text-uppercase fw-bold border-bottom pb-3 mb-4">Cooling Fans</h4>

                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border fs-5">
                            <span class="fw-semibold text-dark">Top Fans</span>
                            <span class="badge rounded-pill @(dashBoard.TopFans == "ON" ? "bg-success" : "bg-danger") px-4 py-2 shadow-sm">
                                @dashBoard.TopFans
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border fs-5">
                            <span class="fw-semibold text-dark">Bottom Fans</span>
                            <span class="badge rounded-pill @(dashBoard.BottomFans == "ON" ? "bg-success" : "bg-danger") px-4 py-2 shadow-sm">
                                @dashBoard.BottomFans
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row flex-grow-1">
            <div class="col-12 d-flex flex-column">
                <div class="card shadow border-0 rounded-4 w-100 p-4 flex-grow-1">
                    <h4 class="text-muted text-uppercase fw-bold border-bottom pb-3 mb-3">Event Log</h4>

                    <div class="overflow-auto rounded border flex-grow-1" style="max-height: 400px;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light position-sticky top-0 z-1" style="box-shadow: 0 2px 2px -1px rgba(0, 0, 0, 0.1);">
                                <tr>
                                    <th scope="col" class="ps-3 py-3">Timestamp</th>
                                    <th scope="col" class="py-3">Severity</th>
                                    <th scope="col" class="py-3">Temperature</th>
                                    <th scope="col" class="py-3">Event Info</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (serverEvents != null && serverEvents.Any())
                                {
                                    @foreach (var ev in serverEvents)
                                    {
                                        <tr>
                                            <td class="text-muted ps-3 fw-medium">@ev.Date.AddHours(2).ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>
                                                <span class="badge rounded-pill @(ev.Severity == "Critical" ? "bg-danger text-white" : "bg-warning") px-3 py-2">
                                                    @ev.Severity
                                                </span>
                                            </td>
                                            <td class="fw-bold text-danger">@ev.Temp&deg;C</td>
                                            <td class="text-muted">High temperature threshold exceeded.</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No events found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-grow-1 justify-content-center align-items-center text-muted">
            <div class="spinner-border text-primary mb-4" style="width: 5rem; height: 5rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>