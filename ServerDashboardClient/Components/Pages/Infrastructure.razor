@page "/infrastructure"
@rendermode InteractiveServer

<PageTitle>Server Infrastructuur</PageTitle>

<div class="container-fluid bg-light p-3 p-md-5">
    <h1 class="display-5 fw-bold text-dark text-uppercase mb-4">Proxmox Infrastructure Overview</h1>

    @if (nodes == null)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else
    {
        @if (!nodes.Any())
        {
            <div class="alert alert-info shadow-sm rounded-4 p-4 mb-4">
                <h4 class="alert-heading fw-bold">No nodes found!</h4>
                <p class="mb-0">There are currently no Proxmox nodes registered in the system. Add your first node below to get started.</p>
            </div>
        }
        else
        {
            @foreach (var node in nodes)
            {
                <div class="card shadow border-0 rounded-4 mb-5 p-4">
                    <h2 class="text-primary border-bottom pb-2">@node.Name</h2>

                    <div class="bg-primary bg-opacity-10 border-start border-5 border-primary p-3 my-3 rounded-end">
                        <div class="mb-2">
                            <strong>Hardware Capacity:</strong>
                            <span class="badge bg-purple ms-2" style="background-color: #8e44ad;">@node.RamGb GB RAM</span>
                            <span class="badge bg-info">@node.Cores Cores</span>
                            <span class="badge bg-success">@node.StorageGb GB Storage</span>
                        </div>
 
                        <div>
                            <strong>Total Hardware Usage:</strong>
                            @if (@GetUsage(node.Id).RamGb <= @node.RamGb)
                            {
                                <span class="badge bg-purple ms-2" style="background-color: #8e44ad;">@GetUsage(node.Id).RamGb GB RAM</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-2">@GetUsage(node.Id).RamGb GB RAM</span>
                            }
                            @if (@GetUsage(node.Id).Cores <= @node.Cores)
                            {
                                <span class="badge bg-info ms-1">@GetUsage(node.Id).Cores Cores</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-1">@GetUsage(node.Id).Cores Cores</span>
                            }
                            @if (@GetUsage(node.Id).StorageGb < node.StorageGb)
                            {
                                <span class="badge bg-success ms-1">@GetUsage(node.Id).StorageGb GB Storage</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-1">@GetUsage(node.Id).StorageGb GB Storage</span>
                            }
                        </div>
                    </div>

                    <h3 class="text-secondary mt-4">Virtual Machines</h3>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>VM Name</th>
                                    <th>RAM (GB)</th>
                                    <th>Cores</th>
                                    <th>Storage (GB)</th>
                                    <th>Notes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (node.VirtualMachines.Any())
                                {
                                    @foreach (var vm in node.VirtualMachines)
                                    {
                                        <tr>
                                            <td><strong>@vm.Name</strong></td>
                                            <td>@vm.RamGb GB</td>
                                            <td>@vm.Cores</td>
                                            <td>@vm.StorageGb GB</td>
                                            <td>@vm.Notes</td>
                                            <td>
                                                <button class="btn btn-sm btn-warning" @onclick="() => EditVm(vm)">Edit</button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteVm(vm.Id)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">No virtual machines found on this node.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (nodes.Any())
        {
            <div class="card shadow border-0 rounded-4 p-4 mt-4">
                <h3 class="text-secondary fw-bold mb-3">@(isEditing ? "Edit VM" : "Add New VM")</h3>
                <EditForm Model="currentVm" OnValidSubmit="SaveVm">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="fw-semibold">VM Name</label>
                            <InputText @bind-Value="currentVm.Name" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">RAM (GB)</label>
                            <InputNumber @bind-Value="currentVm.RamGb" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">Cores</label>
                            <InputNumber @bind-Value="currentVm.Cores" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">Storage (GB)</label>
                            <InputNumber @bind-Value="currentVm.StorageGb" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">Select Node</label>
                            <InputSelect @bind-Value="currentVm.ProxmoxNodeId" class="form-select">
                                <option value="0">Select...</option>
                                @foreach (var n in nodes)
                                {
                                    <option value="@n.Id">@n.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-12">
                            <label class="fw-semibold">Notes</label>
                            <InputText @bind-Value="currentVm.Notes" class="form-control" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success px-4 shadow-sm">Save VM</button>
                        @if (isEditing)
                        {
                            <button type="button" class="btn btn-secondary px-4 shadow-sm ms-2" @onclick="ResetForm">Cancel</button>
                        }
                    </div>
                </EditForm>
            </div>
        }

        <div class="card shadow border-0 rounded-4 p-4 mt-4 bg-primary bg-opacity-10">
            <h3 class="text-primary text-uppercase fw-bold mb-3">Add New Node</h3>
            <EditForm Model="currentNode" OnValidSubmit="SaveNode">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="fw-semibold">Node Name</label>
                        <InputText @bind-Value="currentNode.Name" class="form-control" placeholder="E.g., PVE3" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-semibold">RAM (GB)</label>
                        <InputNumber @bind-Value="currentNode.RamGb" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-semibold">Cores</label>
                        <InputNumber @bind-Value="currentNode.Cores" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-semibold">Storage (GB)</label>
                        <InputNumber @bind-Value="currentNode.StorageGb" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3 px-4 shadow-sm">Save Node</button>
            </EditForm>
        </div>
    }
</div>
