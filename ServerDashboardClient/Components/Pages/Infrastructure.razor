@page "/infrastructure"
@rendermode InteractiveServer

@using ServerDashboardApi.DTOs
@using ServerDashboardClient.Services
@inject IInfrastructureClientService _infraClient

<PageTitle>Server Infrastructuur</PageTitle>

<div class="container-fluid bg-light p-3 p-md-5">
    <h1 class="display-5 fw-bold text-dark text-uppercase mb-4">🖥️ Proxmox Infrastructuur Overzicht</h1>

    @if (nodes == null)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else
    {
        @if (!nodes.Any())
        {
            <div class="alert alert-info shadow-sm rounded-4 p-4 mb-4">
                <h4 class="alert-heading fw-bold">Geen nodes gevonden!</h4>
                <p class="mb-0">Er zijn momenteel nog geen Proxmox nodes geregistreerd in het systeem. Voeg hieronder je eerste node toe om te beginnen.</p>
            </div>
        }
        else
        {
            @foreach (var node in nodes)
            {
                <div class="card shadow border-0 rounded-4 mb-5 p-4">
                    <h2 class="text-primary border-bottom pb-2">@node.Name</h2>

                    <div class="bg-primary bg-opacity-10 border-start border-5 border-primary p-3 my-3 rounded-end">
                        <strong>Hardware Capaciteit:</strong>
                        <span class="badge bg-purple ms-2" style="background-color: #8e44ad;">@node.RamGb GB RAM</span>
                        <span class="badge bg-info">@node.Cores Cores</span>
                        <span class="badge bg-success">@node.StorageGb GB Opslag</span>
                    </div>

                    <h3 class="text-secondary mt-4">💻 Virtuele Machines</h3>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>VM Naam</th>
                                    <th>RAM (GB)</th>
                                    <th>Cores</th>
                                    <th>Opslag (GB)</th>
                                    <th>Opmerkingen</th>
                                    <th>Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (node.VirtualMachines.Any())
                                {
                                    @foreach (var vm in node.VirtualMachines)
                                    {
                                        <tr>
                                            <td><strong>@vm.Name</strong></td>
                                            <td>@vm.RamGb GB</td>
                                            <td>@vm.Cores</td>
                                            <td>@vm.StorageGb GB</td>
                                            <td>@vm.Notes</td>
                                            <td>
                                                <button class="btn btn-sm btn-warning" @onclick="() => EditVm(vm)">Bewerk</button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteVm(vm.Id)">X</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">Geen virtuele machines gevonden op deze node.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        <!-- Formulier om een nieuwe NODE toe te voegen -->
        <div class="card shadow border-0 rounded-4 p-4 mt-4 bg-primary bg-opacity-10">
            <h3 class="text-primary text-uppercase fw-bold mb-3">Nieuwe Node Toevoegen</h3>
            <EditForm Model="currentNode" OnValidSubmit="SaveNode">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="fw-semibold">Node Naam</label>
                        <InputText @bind-Value="currentNode.Name" class="form-control" placeholder="Bijv. PVE3" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-semibold">RAM (GB)</label>
                        <InputNumber @bind-Value="currentNode.RamGb" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-semibold">Cores</label>
                        <InputNumber @bind-Value="currentNode.Cores" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-semibold">Opslag (GB)</label>
                        <InputNumber @bind-Value="currentNode.StorageGb" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3 px-4 shadow-sm">Node Opslaan</button>
            </EditForm>
        </div>

        <!-- Formulier om een VM toe te voegen of te updaten (Alleen zinvol als er nodes zijn) -->
        @if (nodes.Any())
        {
            <div class="card shadow border-0 rounded-4 p-4 mt-4">
                <h3 class="text-secondary fw-bold mb-3">@(isEditing ? "VM Bewerken" : "Nieuwe VM Toevoegen")</h3>
                <EditForm Model="currentVm" OnValidSubmit="SaveVm">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="fw-semibold">VM Naam</label>
                            <InputText @bind-Value="currentVm.Name" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">RAM (GB)</label>
                            <InputNumber @bind-Value="currentVm.RamGb" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">Cores</label>
                            <InputNumber @bind-Value="currentVm.Cores" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">Opslag (GB)</label>
                            <InputNumber @bind-Value="currentVm.StorageGb" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="fw-semibold">Kies Node</label>
                            <InputSelect @bind-Value="currentVm.ProxmoxNodeId" class="form-select">
                                <option value="0">Selecteer...</option>
                                @foreach (var n in nodes)
                                {
                                    <option value="@n.Id">@n.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-12">
                            <label class="fw-semibold">Opmerkingen</label>
                            <InputText @bind-Value="currentVm.Notes" class="form-control" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success px-4 shadow-sm">VM Opslaan</button>
                        @if (isEditing)
                        {
                            <button type="button" class="btn btn-secondary px-4 shadow-sm ms-2" @onclick="ResetForm">Annuleren</button>
                        }
                    </div>
                </EditForm>
            </div>
        }
    }
</div>

@code {
    private List<ProxmoxNodeDTO>? nodes;

    private VirtualMachineDTO currentVm = new();
    private ProxmoxNodeDTO currentNode = new();
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        nodes = await _infraClient.GetNodesWithVMsAsync();
    }

    private async Task SaveNode()
    {
        if (string.IsNullOrWhiteSpace(currentNode.Name)) return;

        await _infraClient.AddNodeAsync(currentNode);
        currentNode = new ProxmoxNodeDTO();
        await LoadData();
    }

    private async Task SaveVm()
    {
        if (currentVm.ProxmoxNodeId == 0) return;
        if (isEditing)
        {
            await _infraClient.UpdateVirtualMachineAsync(currentVm);
        }
        else
        {
            await _infraClient.AddVirtualMachineAsync(currentVm);
        }

        ResetForm();
        await LoadData();
    }

    private void EditVm(VirtualMachineDTO vm)
    {
        currentVm = new VirtualMachineDTO
        {
            Id = vm.Id,
            Name = vm.Name,
            RamGb = vm.RamGb,
            Cores = vm.Cores,
            StorageGb = vm.StorageGb,
            Notes = vm.Notes,
            ProxmoxNodeId = vm.ProxmoxNodeId
        };
        isEditing = true;
    }

    private async Task DeleteVm(int id)
    {
        await _infraClient.DeleteVirtualMachineAsync(id);
        await LoadData();
    }

    private void ResetForm()
    {
        currentVm = new VirtualMachineDTO();
        isEditing = false;
    }
}